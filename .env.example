# Copy to .env for local development and add the same keys in Vercel → Project → Settings → Environment Variables.

# PostgreSQL connection string (Neon, Vercel Postgres, Railway, or your own server).
# Hosted databases usually need ?sslmode=require at the end.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/prowexa?sslmode=require

# Comma-separated list of emails allowed to sign in to /admin.
ADMIN_EMAILS=sudhirgaikwad517@gmail.com

# SMTP account used for OTP and acknowledgement emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=connect@prowexa.com
SMTP_PASS=

# Google Analytics 4 measurement ID (optional; leave empty to disable tracking).
VITE_GA_MEASUREMENT_ID=
